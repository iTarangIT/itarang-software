{
  "version": "6.0",
  "screens": [
    {
      "id": "SHOP_PHOTO",
      "title": "Shop photo",
      "terminal": true,
      "success": true,
      "data": {
        "shop": { "type": "string", "__example__": "Sharma Battery House" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "visit_form",
            "children": [
              { "type": "TextSubheading", "text": "${data.shop}" },
              {
                "type": "TextBody",
                "text": "Take a clear photo of the shop or counter with your camera. Gallery photos are not allowed."
              },
              {
                "type": "PhotoPicker",
                "name": "photo",
                "label": "Shop photo",
                "description": "Camera only",
                "photo-source": "camera",
                "min-uploaded-photos": 1,
                "max-uploaded-photos": 1,
                "max-file-size-kb": 15360
              },
              {
                "type": "Footer",
                "label": "Save photo",
                "on-click-action": {
                  "name": "complete",
                  "payload": { "photo": "${form.photo}" }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
