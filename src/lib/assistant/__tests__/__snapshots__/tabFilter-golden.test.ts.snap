 dl.is_active IS NOT FALSE AND (dl.dealer_name ILIKE $2 OR dl.phone ILIKE $3 OR dl.shop_name ILIKE $4) ORDER BY dl.final_intent_score DESC NULLS LAST, dl.created_at DESC LIMIT $5 OFFSET $6",
  },
