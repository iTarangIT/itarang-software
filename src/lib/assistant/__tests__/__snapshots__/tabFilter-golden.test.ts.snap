exports[`queue SQL is unchanged by exporting tabFilter > ASM my_closed 1`] = `
[
  {
    "params": [
      "asm-1",
      "%abc%",
      "%abc%",
      "%abc%",
      10,
      10,
    ],
    "sql": "SELECT dl.id, dl.dealer_name, dl.shop_name, dl.phone, dl.city, dl.state, dl.final_intent_score, dl.lead_status, dl.interest_level, dl.current_owner_id, owner.name AS current_owner_name, dl.asm_id, asm.name AS asm_name, dl.last_touchpoint_at, dl.assigned_at, lv.visit_status, lv.visit_outcome, lv.scheduled_date::text AS scheduled_date, lv.actual_visit_date::text AS actual_visit_date, dl.closed_at, dl.next_follow_up_at , dl.last_disposition AS last_action, dl.last_worked_at::text AS last_action_at, ldv.actual_visit_date::text AS last_visit_date, ldv.visit_outcome AS last_visit_outcome, CASE WHEN dl.last_worked_at IS NULL THEN NULL ELSE ( SELECT COUNT(*) FROM generate_series( ((dl.last_worked_at) AT TIME ZONE 'Asia/Kolkata')::date + 1, ((NOW()) AT TIME ZONE 'Asia/Kolkata')::date, INTERVAL '1 day' ) gs WHERE (EXTRACT(DOW FROM (gs::date))::int IN (1, 2, 3, 4, 5, 6)) AND gs::date NOT IN (SELECT hc.holiday_date FROM holiday_calendar hc WHERE hc.is_active IS NOT FALSE AND hc.holiday_date IS NOT NULL) )::int END AS days_since_action FROM dealer_leads dl LEFT JOIN LATERAL ( SELECT visit_status, visit_outcome, scheduled_date, actual_visit_date FROM lead_visits WHERE dealer_lead_id = dl.id ORDER BY COALESCE(actual_visit_date, scheduled_date, created_at) DESC LIMIT 1 ) lv ON true LEFT JOIN LATERAL ( SELECT actual_visit_date, visit_outcome FROM lead_visits WHERE dealer_lead_id = dl.id AND actual_visit_date IS NOT NULL ORDER BY actual_visit_date DESC, created_at DESC LIMIT 1 ) ldv ON true LEFT JOIN users owner ON owner.id::text = dl.current_owner_id LEFT JOIN users asm ON asm.id::text = dl.asm_id WHERE dl.closing_owner_id = $1 AND dl.lead_status IN ('Converted', 'Lost') AND dl.closed_at >= NOW() - INTERVAL '90 days' AND dl.is_active IS NOT FALSE AND (dl.dealer_name ILIKE $2 OR dl.phone ILIKE $3 OR dl.shop_name ILIKE $4) ORDER BY dl.closed_at DESC NULLS LAST LIMIT $5 OFFSET $6",
  },
  {
    "params": [
      "asm-1",
      "%abc%",
      "%abc%",
      "%abc%",
    ],
    "sql": "SELECT COUNT(*)::text AS c FROM dealer_leads dl LEFT JOIN LATERAL ( SELECT visit_status, visit_outcome, scheduled_date, actual_visit_date FROM lead_visits WHERE dealer_lead_id = dl.id ORDER BY COALESCE(actual_visit_date, scheduled_date, created_at) DESC LIMIT 1 ) lv ON true WHERE dl.closing_owner_id = $1 AND dl.lead_status IN ('Converted', 'Lost') AND dl.closed_at >= NOW() - INTERVAL '90 days' AND dl.is_active IS NOT FALSE AND (dl.dealer_name ILIKE $2 OR dl.phone ILIKE $3 OR dl.shop_name ILIKE $4)",
  },
]
`;

