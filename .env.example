# Example environment variables. Copy the ones you need into .env.local.
# Never commit real values.

# --- Ecofy ⇄ CRM sync (docs/ECOFY_INTEGRATION.md) ---------------------------
# Shared HMAC secret, >= 32 chars, one per environment. Same value as
# ITARANG_CRM_SECRET on the Ecofy side. Blank = inbound endpoint answers 503
# and nothing is sent.
ECOFY_SYNC_SECRET=
# Ecofy's inbound events endpoint (CRM -> Ecofy events, §4).
ECOFY_EVENTS_URL=https://sandbox-ecofy.itarang.com/api/v1/integrations/itarang/events
# Ecofy REST API base (signed server-to-server calls, §5).
ECOFY_API_BASE=https://sandbox-ecofy.itarang.com/api/v1

# --- Green Energy News feed (E-306, CEO dashboard) --------------------------
# The in-process refresh ticker runs in production by default. Outside
# production it stays dark unless ENABLE_GREEN_NEWS=1; ENABLE_GREEN_NEWS=0
# switches it off anywhere. Gemini key: GEMINI_API_KEY_FOR_SUMMARY, else
# GEMINI_API_KEY. Model defaults to gemini-flash-lite-latest.
# ENABLE_GREEN_NEWS=1
# GEMINI_NEWS_MODEL=gemini-flash-lite-latest
ITARANG_CRM_ACTOR_EMAIL=anirudh@itarang.com

# ── WhatsApp Sales Assistant: channel (src/lib/wa-assistant/env.ts) ─────────
# Its own names — never the dealer bot's META_WA_*. Today the token and app
# secret hold the SAME values as the dealer bot (same Meta app and WABA); the
# separate names let the two flows be split later without a code change.
# If any required one is missing, /api/assistant/wa/webhook answers 503 and the
# Link WhatsApp page says linking is unavailable. The rest of the CRM is unaffected.

# Required. Meta phone_number_id of the Assistant's number (API Setup → "From").
# Sandbox: the Meta TEST number's id. Production: the real number's id.
WA_ASSIST_PHONE_NUMBER_ID=
# Required. Permanent System-User token with whatsapp_business_messaging.
WA_ASSIST_ACCESS_TOKEN=
# Required. The Meta app's App Secret; verifies x-hub-signature-256 on inbound
# webhooks and keys the HMAC of LINK codes.
WA_ASSIST_APP_SECRET=
# Required. Any long random string; paste the same value into the number-level
# webhook override in Meta (callback URL https://<host>/api/assistant/wa/webhook).
WA_ASSIST_VERIFY_TOKEN=
# Optional. Graph API version. Default v21.0.
WA_ASSIST_GRAPH_VERSION=v21.0
# Optional. Display only: the number shown on Settings → Link WhatsApp,
# e.g. "+91 98XXX XXXXX". Blank = the page says "the iTarang Sales Assistant number".
WA_ASSIST_DISPLAY_NUMBER=

# ── WhatsApp Sales Assistant: agent (from Gate 2) ───────────────────────────
# Required once the agent is live. Google AI Studio API key used ONLY by the
# Sales Assistant agent (LangChain ChatGoogleGenerativeAI) — not the dealer
# bot's GEMINI_WHATSAPP_API_KEY. Unset = linked users get "being set up".
WA_ASSIST_GEMINI_API_KEY=
# Optional. Gemini model id. Default gemini-3.6-flash (gemini-2.5-flash is closed to new API users).
ASSISTANT_MODEL=
# Pilot allow-list for WRITE tools: comma-separated users.id (uuid) values.
# Empty = nobody can propose writes; reads still work for every linked ASM/ISR.
# Checked when a preview is built AND again when Confirm is tapped.
ASSISTANT_WRITES_ENABLED_USER_IDS=
# Global kill switch. true = every linked user gets one fixed "paused" reply,
# no model call, no data. LINK still works.
ASSISTANT_DISABLED=false

# Voice notes: transcribed with Gemini on WA_ASSIST_GEMINI_API_KEY, then handled
# like typed text. true = voice notes get the "please type it" reply instead.
WA_ASSIST_VOICE_DISABLED=false
# Transcription model; blank = ASSISTANT_MODEL's default.
WA_ASSIST_STT_MODEL=

# ── Data Analyst agent (/ceo/analyst, /sales-head/analyst) ─────────────────
# Separate Python service (github.com/iTarangIT/Data-Analysis-Agent-Main). The CRM
# calls it server-side only, signed in as ONE service account on the agent's own
# Supabase project (the agent rejects tokens from the CRM's auth project).
# Testing: Render. Later: the Hostinger deploy — only ANALYST_API_URL changes.
ANALYST_API_URL=https://data-analysis-agent-main.onrender.com
# The agent's Supabase project (its SUPABASE_URL), NOT the CRM's.
ANALYST_SUPABASE_URL=
# That project's publishable / anon key.
ANALYST_SUPABASE_KEY=
# The service account: a user that exists in the agent's project and is a member
# of the agent tenant that owns the data connections.
ANALYST_SERVICE_EMAIL=
ANALYST_SERVICE_PASSWORD=
# JSON-call timeout; runs themselves stream with no timeout. Default 15000.
ANALYST_API_TIMEOUT_MS=
# Read-only login to THIS CRM's database for the analyst's one-click "iTarang database" source.
# Create it with scripts/_create-analyst-readonly-role.mjs; the DSN never reaches the browser.
ANALYST_CRM_READONLY_DSN=

# --- API and webhook caller checks (tracker ID 118) --------------------------
# Middleware gate for /api/* calls with no session that are not on the public
# list (src/lib/security/publicApi.ts). report (default) = log only,
# enforce = answer 401, off = do nothing.
API_AUTH_GATE=report
# Digio webhook secret key (Enterprise Dashboard -> Profile -> Webhook). When
# set, every Digio webhook must carry a matching X-Digio-Checksum header.
# Sandbox and production have separate keys. Blank = accepted but logged.
DIGIO_WEBHOOK_SECRET=
# Shared secret Bolna sends as "Authorization: Bearer <value>" on call webhooks.
BOLNA_WEBHOOK_SECRET=
# Same idea for the in-call tool endpoints (/api/bolna/tools/*): set it as the
# tool api_token ("Bearer <value>") on the Bolna agent. Separate from the
# webhook secret so setting one does not break the other.
BOLNA_TOOL_SECRET=
# 1 = refuse any webhook or callback that cannot be verified (no secret set, or
# an NBFC callback with no signature). Turn on only after the secrets above are
# set and the "[webhook-auth] UNVERIFIED" log lines have stopped.
WEBHOOK_AUTH_STRICT=
